# CutPilot Environment Configuration Template
# Copy this file to .env and configure your local settings.
# Never commit your .env file containing actual secret keys to source control!

# ==============================================================================
# 1. Cloud Multi-Modal Inference (Optional - Agent 2 Visual Analysis)
# ==============================================================================
# Used for video semantics, shot understanding, and OCR scene analysis.
# Leave blank or unconfigured to disable cloud inference features.
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 2. DaVinci Resolve In-App Loopback Bridge (Agent 3 Conforming & Automation)
# ==============================================================================
DAVINCI_RESOLVE_BRIDGE=1
DAVINCI_RESOLVE_BRIDGE_HOST=127.0.0.1
DAVINCI_RESOLVE_BRIDGE_PORT=49632

# ==============================================================================
# 3. Optional Binary Overrides (Default: auto-discovered from PATH or resources/bin/)
# ==============================================================================
# CutPilot automatically detects your OS and CPU architecture (Windows ARM64/x64,
# macOS Apple Silicon, Linux x64) and discovers binaries on your system PATH or
# under resources/bin/{platform_slug}/.
# Uncomment and configure these ONLY if you need custom paths:
#
# CUTPILOT_FFMPEG_PATH=resources/bin/windows-arm64/ffmpeg/ffmpeg.exe
# CUTPILOT_FFPROBE_PATH=resources/bin/windows-arm64/ffmpeg/ffprobe.exe
# CUTPILOT_WHISPER_PATH=resources/bin/windows-arm64/whisper/whisper-cli.exe
# CUTPILOT_WHISPER_MODEL=resources/models/whisper/ggml-base.bin
